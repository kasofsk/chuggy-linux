    "@chuggy/worker-core",
    "zod"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "jscpd": "5.0.5",
    "prettier": "^3.9.6",
