{
  "name": "chuggy-linux",
  "version": "0.3.0",
  "description": "Runs a chuggy worker pool's jobs in containers on a Linux machine",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "bin": {
    "chuggy-linux": "cli.mjs"
  },
  "dependencies": {
    "@chuggy/worker-contract": "https://github.com/kasofsk/chuggy/releases/download/worker-contract-v1.3.0/chuggy-worker-contract-1.3.0.tgz",
    "@chuggy/worker-core": "github:kasofsk/chuggy-common#8ef2cadef8dd946778e8a59cc00e3ca3fd3d838d",
    "zod": "4.5.4"
  },
  "bundleDependencies": [
    "@chuggy/worker-contract",
    "@chuggy/worker-core",
    "zod"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "jscpd": "5.0.5",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "files": [
    "cli.mjs",
    "commands.mjs",
    "containerBackend.mjs",
    "control.mjs",
